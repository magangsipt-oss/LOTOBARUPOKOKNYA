# Docker Compose settings for E-LOTO. Copy to .env (never commit .env):
#   cp .env.example .env && chmod 600 .env
# Generate passwords with:  openssl rand -base64 24

# Public domain (A record -> this server) and the server's public IP (used by the box).
ELOTO_DOMAIN=eloto-safety.web.id
ELOTO_IP=203.0.113.10

DB_NAME=eloto_db
DB_USER=eloto_app
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Optional: camera MJPEG ports per box, e.g. {"BOX ELOTO 1":8081}
MJPEG_PORTS=
