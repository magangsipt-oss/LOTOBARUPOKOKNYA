# pnpm dev / pnpm dev:counting loads counting/.env automatically.
# Existing environment variables take precedence.
ELOTO_API_URL=https://eloto.example.com/api
ELOTO_BOX_ID=BOX ELOTO 1
ELOTO_DEVICE_TOKEN=replace-with-provisioned-device-token
ELOTO_RTSP_URL=rtsp://camera-user:camera-password@camera-host:554/stream
ELOTO_MJPEG_PORT=8081
ELOTO_HEADLESS=1
ELOTO_SYNC_INTERVAL=5
