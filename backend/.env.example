NODE_ENV=development
HOST=0.0.0.0
PORT=5002
FRONTEND_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eloto_db
DB_USER=eloto_app
DB_PASSWORD=replace-with-a-local-secret
# Production defaults to trusting the loopback reverse proxy.
# Override only if a different proxy hop is explicitly trusted.
# TRUST_PROXY=loopback
# Explicit mapping prevents one box displaying another box's video.
MJPEG_PORTS={"BOX ELOTO 1":8081,"BOX ELOTO 2":8082}
